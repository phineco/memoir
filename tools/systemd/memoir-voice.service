[Unit]
Description=Memoir private voice queue
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=memoir
WorkingDirectory=/opt/memoir
EnvironmentFile=/opt/memoir/.env
Environment=TZ=Asia/Shanghai
ExecStart=/opt/memoir/.venv/bin/python -B tools/voice_jobs.py --watch
Restart=on-failure
RestartSec=5
TimeoutStopSec=600
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
