[Unit]
Description=Memoir private question queue
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=memoir
WorkingDirectory=/opt/memoir
EnvironmentFile=/opt/memoir/.env
Environment=TZ=Asia/Shanghai
ExecStartPre=/opt/memoir/.venv/bin/python tools/check_database.py
ExecStart=/opt/memoir/.venv/bin/python -B tools/ai_jobs.py --queue question
Restart=on-failure
RestartSec=5
TimeoutStopSec=360
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
