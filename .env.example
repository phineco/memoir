# 复制为 .env（或直接 export），再启动应用
# cp .env.example .env

# ---------- 运行环境开关 ----------
# local = 本地部署（默认）：SQLite + 本地磁盘存照片
# cloud = 云环境：MySQL + 阿里云 OSS 私有桶
APP_ENV=local
# 对外邀请地址使用公开域名，不使用反向代理内部 Host
PUBLIC_BASE_URL=https://family.scyllatech.cn
# 公开展示在协议与隐私政策中的权利申请邮箱（正式上线前必须填写可用邮箱）
PRIVACY_CONTACT_EMAIL=info@scyllatech.cn

# ---------- 数据库 ----------
# 本地默认 sqlite；云环境示例：
# DATABASE_URL=mysql+pymysql://user:password@rm-xxx.mysql.rds.aliyuncs.com:3306/memoir?charset=utf8mb4
DATABASE_URL=sqlite:///memoir.db
# MySQL 连接最长复用秒数；应小于数据库 wait_timeout，默认 1800（正整数）
# 取用连接前始终检查存活；SQLite 不按时长回收，避免丢失内存库
DB_POOL_RECYCLE_SECONDS=1800

# ---------- 存储后端 ----------
# local | oss；不填则跟随 APP_ENV（local→local，cloud→oss）
# STORAGE_BACKEND=local

# 本地存储目录（STORAGE_BACKEND=local 时生效）
# UPLOAD_DIR=./uploads

# ---------- 阿里云 OSS（STORAGE_BACKEND=oss 时生效，SDK v2） ----------
# 地域 ID，如 cn-hangzhou（与 bucket 同地域）
OSS_REGION=
# 私有桶名（建议私有桶 + 签名 URL 访问，见架构文档）
OSS_BUCKET=
# 可选；不填则 SDK 按 region 自动拼 endpoint
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# 建议用 RAM 子账号 AK，只授 oss:PutObject / oss:GetObject
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 照片签名 URL 有效期（秒），默认 3600
# OSS_URL_EXPIRES=3600

# ---------- 其他 ----------
# SECRET_KEY=请换成随机长字符串
# 管理员开通/重置账号结果的服务端私有临时目录；不填使用应用默认位置。
# 不得放在 static 或可直接下载的位置；多实例部署须共用安全存储。
# ACCOUNT_NOTICE_DIR=/path/to/private/account-notices

# ---------- AI（DeepSeek，预置提示词直调） ----------
# 不填则 AI 问答/周报导读功能隐藏（优雅降级）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# ---------- 阿里云短信（验证码登录 / 注册 / 找回密码） ----------
# 缺配置时短信验证停用。仅本地测试可显式开启测试码；cloud 环境即使设为 1 也禁用。
SMS_DEVELOPMENT_MODE=0
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=家音
# ALIYUN_SMS_TEMPLATE_CODE=SMS_XXXXXX
# 可选；默认 dysmsapi.aliyuncs.com（杭州），一般不用改
# ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# 周报当前 ISO 年周口径；服务进程 TZ 应保持同一时区（旧审计时间未保存时区）。
APP_TIMEZONE=Asia/Shanghai

# 版本通常自动读取 RELEASE.json 或 Git；源码之外的部署可显式提供发布标识
# APP_VERSION=release-id
# 只记录端点、编号、状态和耗时，不记录正文/参数；生产采样前可开启
REQUEST_LOGGING=0

# 站点运营账号内部 ID，逗号分隔；默认无人，家庭管理员不会自动获得权限
# 配置并核验有效运营账号后才开放站内隐私申请，否则保留邮箱渠道
OPERATIONS_USER_IDS=

# 本站浏览器保留/恢复状态样本；默认关闭，需有效运营账号并落实告知与清理安排后启用
# 不上报正文、文章 ID、问题或完整网址；90 天前的样本由 tools/usage_retention.py 清理
USAGE_METRICS_ENABLED=0

# ---------- 家人声音 v1：全部默认关闭，不读取本机钥匙串 ----------
VOICE_ENABLED=0
# 完成真实服务许可、实名/单独同意、影响评估及删除联调后，由运营明确开启
VOICE_COMPLIANCE_APPROVED=0
# 已故亲人另须共同确认及服务商明确许可；不随总开关开启
VOICE_DECEASED_ENABLED=0
# DASHSCOPE_API_KEY=
VOICE_WORKSPACE_ID=
VOICE_MODEL=cosyvoice-v3.5-flash
# 显式分配家庭名额及月字符预算，不代表已有支付/套餐；未配置家庭均为 0
VOICE_FAMILY_LIMITS={}
# 例如（替换实际家庭内部 ID）：
# VOICE_FAMILY_LIMITS='{"family-id":{"voices":2,"monthly_characters":100000}}'
# 录音/已有音频的限时解码、截取需要安装 FFmpeg；可指定绝对路径
VOICE_FFMPEG=ffmpeg

# ---------- 站内 AI 整理与采访（独立于家人声音复刻） ----------
# 以下仅影响相应能力；开启前先完成迁移，并按 DEPLOY.md 启动独立后台队列。
# 整理队列：python tools/ai_jobs.py --queue organize
# 采访提问队列：python tools/ai_jobs.py --queue question
# 转写及录音删除清理队列：python tools/ai_jobs.py --queue asr
# Web 与所有 worker 必须使用同一配置、数据库和私有媒体目录/存储权限。

# 文字整理：需本开关 + INAPP_AI_DATA_APPROVED=1 + 有效 DEEPSEEK_API_KEY。
# 关闭时仍可保存私有原稿、人工整理；不会自动发布故事。
ORGANIZE_ENABLED=0
# 运营完成原稿/采访文字交给模型处理的用途、许可及预算核验后设为 1；
# 不替代用户在页面的用途确认，也不启用录音转写或声音复刻。
INAPP_AI_DATA_APPROVED=0
# 整理使用的模型；未设置时跟随 DEEPSEEK_MODEL，填值时覆盖。
ORGANIZE_MODEL=deepseek-flash
# 每次整理响应的最大输出 token 数；截断结果不会直接入稿。
ORGANIZE_MAX_TOKENS=12000
# 每个用户每日整理任务数 / 原稿字符总量（含失败或未知结果的尝试）。
# 按站点 APP_TIMEZONE 的自然日计；字符额度不是费用或 token 上限。
ORGANIZE_DAILY_TASKS=10
ORGANIZE_DAILY_CHARS=50000

# ---------- 单题采访与 AI 追问 ----------
# 需本开关 + INAPP_AI_DATA_APPROVED=1 + 有效 DEEPSEEK_API_KEY。
# 关闭时使用预置问题，仍可录音或填写文字；采集原声不等于授权复刻。
INTERVIEW_AI_ENABLED=0
# 留空跟随 DEEPSEEK_MODEL；不与声音复刻模型共用。
INTERVIEW_MODEL=
# 每次提问响应最大输出 token 数。
INTERVIEW_MAX_TOKENS=500
# 每个用户每日 AI 问题任务额度；与整理、转写额度分别计算。
INTERVIEW_DAILY_QUESTIONS=50

# ---------- 阿里云录音转写（私有音频输入，不提供公共录音链接） ----------
# 必须同时开启本开关和 INTERVIEW_ASR_DATA_APPROVED，配置有效密钥及地址，
# 并取得用户对该段转写的确认。保持默认 0 可使用录音回听和人工填写。
INTERVIEW_ASR_ENABLED=0
# 完成真实口音质量、费用及服务商数据保留/删除政策核验后再设为 1。
INTERVIEW_ASR_DATA_APPROVED=0
# 优先使用专用转写密钥；留空时回退 DASHSCOPE_API_KEY，仅服务端使用。
# 密钥所属地域/业务空间须匹配下方兼容接口地址。
INTERVIEW_ASR_API_KEY=
# 必填：所选阿里云地域/业务空间的 HTTPS 兼容接口基础地址，
# 不含 /chat/completions；程序会追加该路径，仅接受 aliyuncs.com 域名。
# 请按实际开通服务配置，不把 CosyVoice 的接口地址填到这里。
INTERVIEW_ASR_BASE_URL=
# 须为上述空间已开通的语音识别模型。
INTERVIEW_ASR_MODEL=qwen3-asr-flash
# 每个用户每日转写任务数 / 音频总秒数（含失败或未知结果的尝试）。
# 限额不等于金额预算；未知结果不会自动重试。
INTERVIEW_ASR_DAILY_TASKS=20
INTERVIEW_ASR_DAILY_SECONDS=1800
# 每段原始上传文件字节上限：16777216 = 16 MiB；单段时长另限 3 分钟。
# 音频解码同样使用上方 VOICE_FFMPEG，需 Web/worker 可执行 FFmpeg。
INTERVIEW_MAX_UPLOAD_BYTES=16777216

# ---------- 老人简易版与安装到桌面（先受控验证华为真机） ----------
# 开启 /easy 简易界面；复用原站账号、家庭权限和采访/整理服务。
# 不自动开启 AI、转写或声音复刻，默认关闭不影响完整版。
EASY_ENABLED=0
# 需 EASY_ENABLED=1 才生效；开放 manifest、Service Worker 和安装入口。
# 正式访问需 HTTPS；仅缓存公共静态资源，不缓存家庭网页、照片或录音。
# 不等于已提供原生安卓 APK，也不保证不同手机的安装或后台录音能力。
EASY_PWA_ENABLED=0

# ---------- 显示偏好 ----------
# 1 = 允许本人主动保存账号默认并跨设备读取；0 = 仅使用设备本机设置。
# 优先级：当前账号的设备覆盖 > 账号默认 > 页面默认。
# 保存账号默认不代替用户选择，也不覆盖其他设备已明确保存的偏好。
DISPLAY_ACCOUNT_SYNC_ENABLED=1
