# 复制为 .env（或直接 export），再启动应用
# cp .env.example .env

# ---------- 运行环境开关 ----------
# local = 本地部署（默认）：SQLite + 本地磁盘存照片
# cloud = 云环境：MySQL + 阿里云 OSS 私有桶
APP_ENV=local
# 对外邀请地址使用公开域名，不使用反向代理内部 Host
PUBLIC_BASE_URL=https://family.scyllatech.cn
# 公开展示在协议与隐私政策中的权利申请邮箱（正式上线前必须填写可用邮箱）
PRIVACY_CONTACT_EMAIL=info@scyllatech.cn

# ---------- 数据库 ----------
# 本地默认 sqlite；云环境示例：
# DATABASE_URL=mysql+pymysql://user:password@rm-xxx.mysql.rds.aliyuncs.com:3306/memoir?charset=utf8mb4
DATABASE_URL=sqlite:///memoir.db
# MySQL 连接最长复用秒数；应小于数据库 wait_timeout，默认 1800（正整数）
# 取用连接前始终检查存活；SQLite 不按时长回收，避免丢失内存库
DB_POOL_RECYCLE_SECONDS=1800

# ---------- 存储后端 ----------
# local | oss；不填则跟随 APP_ENV（local→local，cloud→oss）
# STORAGE_BACKEND=local

# 本地存储目录（STORAGE_BACKEND=local 时生效）
# UPLOAD_DIR=./uploads

# ---------- 阿里云 OSS（STORAGE_BACKEND=oss 时生效，SDK v2） ----------
# 地域 ID，如 cn-hangzhou（与 bucket 同地域）
OSS_REGION=
# 私有桶名（建议私有桶 + 签名 URL 访问，见架构文档）
OSS_BUCKET=
# 可选；不填则 SDK 按 region 自动拼 endpoint
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# 建议用 RAM 子账号 AK，只授 oss:PutObject / oss:GetObject
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 照片签名 URL 有效期（秒），默认 3600
# OSS_URL_EXPIRES=3600

# ---------- 其他 ----------
# SECRET_KEY=请换成随机长字符串

# ---------- AI（DeepSeek，预置提示词直调） ----------
# 不填则 AI 问答/周报导读功能隐藏（优雅降级）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# ---------- 阿里云短信（注册验证码 / 找回密码） ----------
# 缺配置时短信验证停用。仅本地测试可显式开启测试码；cloud 环境即使设为 1 也禁用。
SMS_DEVELOPMENT_MODE=0
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=家音
# ALIYUN_SMS_TEMPLATE_CODE=SMS_XXXXXX
# 可选；默认 dysmsapi.aliyuncs.com（杭州），一般不用改
# ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# 周报当前 ISO 年周口径；服务进程 TZ 应保持同一时区（旧审计时间未保存时区）。
APP_TIMEZONE=Asia/Shanghai

# 版本通常自动读取 RELEASE.json 或 Git；源码之外的部署可显式提供发布标识
# APP_VERSION=release-id
# 只记录端点、编号、状态和耗时，不记录正文/参数；生产采样前可开启
REQUEST_LOGGING=0
